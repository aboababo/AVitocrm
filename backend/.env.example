# Backend Environment Variables
DATABASE_URL_ASYNC=sqlite+aiosqlite:///./crm.db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# Avito API Configuration
AVITO_ACCESS_TOKEN=your_avito_access_token_here
AVITO_CLIENT_ID=your_avito_client_id_here
AVITO_CLIENT_SECRET=your_avito_client_secret_here
AVITO_WEBHOOK_URL=https://your-domain.com/api/v1/avito/webhook